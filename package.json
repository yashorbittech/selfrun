    "db:add-products-nav": "npx --yes tsx --require ./scripts/lib/next-server-shims.cjs --env-file=.env scripts/add-products-nav.ts",
    "db:revert-services-nav": "npx --yes tsx --require ./scripts/lib/next-server-shims.cjs --env-file=.env scripts/revert-services-nav.ts",
    "db:seed-dlms": "node --env-file=.env scripts/seed-dlms-demo.mjs",
    "db:seed-aibots": "node --env-file=.env scripts/seed-aibots-demo.mjs",
    "db:seed-smms": "node --env-file=.env scripts/seed-smms-demo.mjs",
    "db:seed-ots": "node --env-file=.env scripts/seed-ots-demo.mjs",
    "db:seed-ots-careers": "node --env-file=.env scripts/seed-ots-careers-demo.mjs",
