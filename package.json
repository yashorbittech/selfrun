{
  "name": "selfrun-business",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "create-lms": "node --env-file=.env scripts/create-lms.mjs",
