    "db:seed-demo-portal": "node --env-file=.env scripts/seed-demo-portal.mjs",
    "db:seed-demo": "node --env-file=.env scripts/seed-all-panels-demo.mjs && node --env-file=.env scripts/seed-demo-portal.mjs && npm run db:migrate-tenancy -- --apply",
    "db:reset-demo": "node --env-file=.env scripts/truncate-all-data.mjs && node --env-file=.env scripts/seed-all-panels-demo.mjs && node --env-file=.env scripts/seed-demo-portal.mjs && npm run db:migrate-tenancy -- --apply",
