    "db:seed-navratri-dussehra-offers": "node --env-file=.env scripts/seed-navratri-dussehra-offers.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@react-pdf/renderer": "^4.9.0",
    "@vercel/blob": "^2.8.0",
