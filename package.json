    "db:seed-cms": "node --env-file=.env scripts/seed-cms-demo.mjs",
    "db:migrate-tenancy": "npx --yes tsx --env-file=.env scripts/migrate-to-multitenant.ts",
    "db:seed-panels": "npx --yes tsx --require ./scripts/lib/next-server-shims.cjs --env-file=.env scripts/seed-panels.ts",
