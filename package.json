    "db:create-company": "npx --yes tsx --require ./scripts/lib/next-server-shims.cjs --env-file=.env scripts/create-company.ts",
    "db:seed-owner-profile": "npx --yes tsx --require ./scripts/lib/next-server-shims.cjs --env-file=.env scripts/seed-owner-profile.ts",
