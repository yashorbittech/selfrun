# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# locally-stored applicant resumes (PII — never commit)
/uploads/

# typescript
*.tsbuildinfo
next-env.d.ts

# Local setup notes with real values
SETUP.local.md

# Built apps (desktop and mobile)
/desktop/node_modules
/desktop/dist
/desktop/dist-company
/desktop/brand.json
/desktop/brand.json.bak
/desktop/build/company-*
/mobile/node_modules
/mobile/work
