# SelfRun Business — required environment variables.
# Copy to `.env` (git-ignored) and fill in. Never commit real values.
# Optional feature keys (voice, payouts, TURN, API secrets, social publishing, …) are listed in README.md.

# MongoDB connection string. Use a NEW, EMPTY database; the database name is the URI path.
MONGODB_URI=""

# First platform staff account, created automatically on the first start.
# Quote the password if it contains `#` or spaces. Omit it to get a temporary one in the server log.
SAAS_ADMIN_EMAIL=""
SAAS_ADMIN_PASSWORD=""

# Encrypts platform secrets stored in the database. Generate once and keep it: openssl rand -base64 32
PLATFORM_ENCRYPTION_KEY=""

# Encrypt bank details (HR), finance bank accounts, Digi Locker credentials and social tokens.
# One separate key each: openssl rand -base64 32. Never change a key once data is stored.
HRMS_ENCRYPTION_KEY=""
FMS_ENCRYPTION_KEY=""
DLMS_ENCRYPTION_KEY=""
SMMS_ENCRYPTION_KEY=""

# Vercel Blob (private store): every file upload.
BLOB_READ_WRITE_TOKEN=""

# Web Push (notifications to the installed app). Generate once: npx web-push generate-vapid-keys
# Keep the private key secret and do not change the pair later (devices would have to re-subscribe).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""

# OpenAI: AI chatbot, assistants, Intelligence and generation.
OPENAI_API_KEY=""

# ── Production (Vercel) only ────────────────────────────────────────────────
# SAAS_HOSTS=selfrunbusiness.com
# PLATFORM_ROOT_DOMAIN=selfrunbusiness.com
# CRON_SECRET=""
# Optional: where people download the desktop app ("Mobile app" settings page). {address} is replaced by the company's app address.
# DESKTOP_DOWNLOAD_URL=
# Automatic desktop-app builds (see docs/deploy-vercel.md, "Desktop apps"): all three are needed.
# GITHUB_REPOSITORY="owner/repo"
# GITHUB_DISPATCH_TOKEN=""
# DESKTOP_BUILD_SECRET=""
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=""
# EMAIL_FROM="SelfRun Business <no-reply@selfrunbusiness.com>"
