# ---------------------------------------------------------------------------
# Demo Company — environment variables
# Copy to `.env` and fill in. `.env*` is gitignored.
# ---------------------------------------------------------------------------

# MongoDB connection string (Atlas). Database name is taken from the URI path.
MONGODB_URI="mongodb+srv://user:pass@cluster.mongodb.net/demo"

# Vercel Blob — persistent storage for every file upload in the app (resumes,
# chat attachments, HRMS/PMS/FMS/PRMS documents, KB PDFs, voice audio). All
# blobs are private (see src/lib/storage/blob.ts). REQUIRED for uploads to
# work locally: on Vercel itself, a connected Blob store injects credentials
# automatically via OIDC and this is not needed there. Generate this from the
# Blob store's dashboard settings after creating a *private* store (Storage
# tab → Create Database → Blob → access mode "Private" — this can't be
# changed after creation).
BLOB_STORE_ID=""
BLOB_READ_WRITE_TOKEN=""
BLOB_WEBHOOK_PUBLIC_KEY=""

# ---------------------------------------------------------------------------
# AI Chatbot (Demo Company AI Assistant)
# ---------------------------------------------------------------------------

# OpenAI API key — powers the RAG chatbot (Responses API + file_search +
# hosted vector stores). Server-only; never exposed to the browser. REQUIRED
# for the chatbot to function.
OPENAI_API_KEY=""

# Optional. The OpenAI Vector Store that holds the knowledge base. If unset,
# one is created automatically on the first index run and its id is persisted
# into the `ai_chatbot_config` document — you do not normally need to set this.
OPENAI_CHATBOT_VECTOR_STORE_ID=""

# Optional. Base URL the knowledge-base crawler fetches public pages from.
# Defaults to the request origin, falling back to the production site URL.
# Set this when indexing from a machine that can't reach the public domain
# (e.g. local dev: "http://localhost:3000").
CHATBOT_CRAWL_BASE_URL=""

# Optional. Bearer secret to allow triggering a knowledge-base re-index via
# `POST /api/admin/chatbot/reindex` without an admin session (for cron / CI).
CHATBOT_ADMIN_API_SECRET=""

# ---------------------------------------------------------------------------
# Conversation AI (ElevenLabs voice layer)
# ---------------------------------------------------------------------------

# ElevenLabs API key — powers voice mode on the Ask Demo Company page:
# speech-to-text (Scribe) for the visitor's question and streaming
# text-to-speech for the AI's answer. Server-only; never sent to the browser.
# Voice mode stays disabled until this is set AND enabled in
# Admin → AI Chatbot → Conversation AI.
ELEVENLABS_API_KEY=""

# ---------------------------------------------------------------------------
# Existing integrations
# ---------------------------------------------------------------------------

# Optional bearer secret for admin lead/PII API endpoints and CSV exports.
LEADS_API_SECRET=""

# Optional bearer secret for HRMS API endpoints (e.g. the employee CSV export
# at /api/hrms/employees/export) so cron / external tooling can call them
# without an HRMS session cookie. Same idea as LEADS_API_SECRET.
HRMS_API_SECRET=""

# App-level encryption for employee bank details (AES-256-GCM). REQUIRED before
# HR can store any bank account. Generate with:  openssl rand -base64 32
# Rotating the key means re-encrypting every hrms_bank_accounts row with the new
# key while the old one is still set — do not just swap it.
HRMS_ENCRYPTION_KEY=""

# App-level encryption for FMS company bank account numbers (AES-256-GCM).
# A separate key from HRMS_ENCRYPTION_KEY on purpose — see fms/crypto.ts.
# REQUIRED before Finance can store a bank account number. Generate with:
#   openssl rand -base64 32
FMS_ENCRYPTION_KEY=""
# DLMS (Digi Locker) — AES-256-GCM key for stored credentials: openssl rand -base64 32
DLMS_ENCRYPTION_KEY=""

# Salary payout disbursement provider. "manual" (HR records UTRs after paying
# through their own bank) or "razorpay" (RazorpayX Payouts).
HRMS_PAYOUT_PROVIDER="manual"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_ACCOUNT_NUMBER=""     # RazorpayX source account that payouts debit
RAZORPAY_WEBHOOK_SECRET=""     # verifies POST /api/hrms/payroll/webhook
# SaaS subscription billing: keys are saved (encrypted) in Platform Panel → Payments & Razorpay;
# RAZORPAY_KEY_ID/SECRET above are only a fallback until then. The webhook secret stays env-only.
RAZORPAY_BILLING_WEBHOOK_SECRET=""   # verifies POST /api/platform/billing/webhook

# Optional bearer secret for the Google Indexing notification endpoint.
INDEXING_API_SECRET=""

# Google Search Console site verification token (public).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""

# ---------------------------------------------------------------------------
# Messenger calling — WebRTC (all optional).
# Media is peer-to-peer; STUN-only connects on the same LAN and most home NATs.
# Add a TURN relay for reliable calls between arbitrary networks.
# ---------------------------------------------------------------------------
MESSENGER_TURN_URL=""          # e.g. turn:turn.selfrunbusiness.ai:3478
MESSENGER_TURN_USERNAME=""
MESSENGER_TURN_CREDENTIAL=""
MESSENGER_CALL_MAX="12"        # max participants per mesh call

# ─────────────────────────────────────────────────────────────────────────────
# SaaS platform (multi-tenant) — set these on the PRODUCTION deployment.
# Full step-by-step guide: docs/deploy-vercel.md
# ─────────────────────────────────────────────────────────────────────────────

# The domain every company's automatic address lives under: <slug>.<this>. REQUIRED in production — without it
# (and outside Vercel production) the app falls back to "localhost". Platform Panel → Integrations can override it.
PLATFORM_ROOT_DOMAIN=selfrunbusiness.ai
# Hosts that serve the SaaS product website, sign-up and Platform Panel (comma separated; `www.` is added). In development localhost is one automatically.
SAAS_HOSTS=selfrunbusiness.ai
# Extra hostnames that serve the platform owner's own site (comma separated). selfrunbusiness.ai and www.selfrunbusiness.ai
# already do, because they come from the root domain. Only needed for additional domains.
PLATFORM_HOSTS=
# Set to 1 once the wildcard domain *.<root> is added to the Vercel project: company subdomains are then served with
# TLS automatically and are NOT attached one by one (keeps the project's domain count flat).
PLATFORM_WILDCARD_SUBDOMAINS=1
# openssl rand -base64 32 — encrypts provider secrets stored in the database. Server-side only.
PLATFORM_ENCRYPTION_KEY=
# Long random string; Vercel sends it as "Authorization: Bearer <value>" to every /api/**/cron route.
CRON_SECRET=
# Public origin of the platform owner's own site (payment links etc.).
NEXT_PUBLIC_APP_URL=https://www.selfrunbusiness.ai

# Custom domains for customers: "vercel" attaches/verifies them through the Vercel API, "manual" does nothing.
# Platform Panel → Integrations can hold these instead (the token is stored encrypted).
DOMAIN_PROVIDER=vercel
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=

# Transactional email (sign-up confirmation, workspace ready, invitations): "resend" or "console" (logs only).
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM="Demo Company <no-reply@selfrunbusiness.ai>"

# First start of a new deployment creates the platform operator (the staff login for /platform) from these.
SAAS_ADMIN_EMAIL=
# SAAS_ADMIN_PASSWORD=   (optional; omitted = a temporary password is printed once in the server log)
